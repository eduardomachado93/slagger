{
    "name": "eduardomachado93/slagger",
    "description": "Automatic OpenAPI/Swagger generation for Slim 4 using PHP 8 Attributes and Reflection",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "slim/slim": "^4.12",
        "cebe/php-openapi": "^1.7"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0 || ^11.0",
        "phpstan/phpstan": "^1.11",
        "nyholm/psr7": "^1.8",
        "nyholm/psr7-server": "^1.1"
    },
    "autoload": {
        "psr-4": {
            "Slagger\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Slagger\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "phpstan": "phpstan analyse -c phpstan.neon"
    },
    "config": {
        "sort-packages": true
    }
}
